#!/bin/zsh
set -euo pipefail

URL="http://127.0.0.1:3080"
LABEL="com.local.deepseek-harness-web"
INSTALLER="$HOME/Library/Application Support/DeepSeek Harness Web/install-service.command"
LOG_FILE="$HOME/Library/Application Support/DeepSeek Harness Web/logs/dsh-web.log"

launch_url() {
  local token_url=""
  if [[ -f "$LOG_FILE" ]]; then
    token_url="$(/usr/bin/awk '/dsh web: http:\/\/127\.0\.0\.1:3080\/\?token=/{url=$NF} END{print url}' "$LOG_FILE")"
  fi
  printf '%s\n' "${token_url:-$URL}"
}

is_ready() {
  local http_status
  http_status="$(/usr/bin/curl -sS -o /dev/null -w '%{http_code}' "$(launch_url)" 2>/dev/null || true)"
  [[ "$http_status" == 2* || "$http_status" == 3* ]]
}

notify() {
  /usr/bin/osascript -e "display notification \"$1\" with title \"DeepSeek Harness Web\"" >/dev/null 2>&1 || true
}

open_url() {
  local target
  target="$(launch_url)"
  /usr/bin/open "$target"
}

if is_ready; then
  open_url
  exit 0
fi

if ! launchctl print "gui/$(id -u)/$LABEL" >/dev/null 2>&1; then
  if [[ -x "$INSTALLER" ]]; then
    "$INSTALLER" >/dev/null 2>&1 || true
  fi
else
  launchctl kickstart -k "gui/$(id -u)/$LABEL" >/dev/null 2>&1 || true
fi

notify "Starting DeepSeek Harness Web. First launch can take several minutes."

for _ in {1..240}; do
  if is_ready; then
    open_url
    notify "DeepSeek Harness Web is ready."
    exit 0
  fi
  /bin/sleep 1
done

open_url
if [[ -f "$LOG_FILE" ]]; then
  /usr/bin/open -R "$LOG_FILE" >/dev/null 2>&1 || true
fi
notify "Still starting or failed. Check the log file."
exit 0
